{
  "name": "@workflow/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API, auth, multi-tenancy, persistence, webhooks, triggers and queue workers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch-path=./src --no-node-snapshot --enable-experimental-regexp-engine-on-excessive-backtracks --regexp-backtracks-before-fallback=1000 --import tsx --import ./src/register-hooks.mjs src/cli.ts start",
    "start": "node --no-node-snapshot --enable-experimental-regexp-engine-on-excessive-backtracks --regexp-backtracks-before-fallback=1000 --import tsx --import ./src/register-hooks.mjs src/cli.ts start",
    "worker": "node --no-node-snapshot --enable-experimental-regexp-engine-on-excessive-backtracks --regexp-backtracks-before-fallback=1000 --import tsx --import ./src/register-hooks.mjs src/cli.ts worker",
    "migrate": "node --no-node-snapshot --enable-experimental-regexp-engine-on-excessive-backtracks --regexp-backtracks-before-fallback=1000 --import tsx --import ./src/register-hooks.mjs src/cli.ts migrate",
    "seed": "node --no-node-snapshot --enable-experimental-regexp-engine-on-excessive-backtracks --regexp-backtracks-before-fallback=1000 --import tsx --import ./src/register-hooks.mjs src/cli.ts seed",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@node-rs/argon2": "2.2.2",
    "@workflow/core": "workspace:*",
    "@workflow/nodes-ai": "workspace:*",
    "@workflow/nodes-base": "workspace:*",
    "@workflow/workflow": "workspace:*",
    "bullmq": "6.5.1",
    "croner": "11.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "ldapts": "9.2.0",
    "openid-client": "6.8.8",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "samlify": "2.15.1",
    "tsx": "4.23.15",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@workflow/chat-widget": "workspace:*",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
