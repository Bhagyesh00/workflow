{
  "name": "workflow-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant workflow automation platform (node-graph editor, execution engine, integrations, AI agents)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
